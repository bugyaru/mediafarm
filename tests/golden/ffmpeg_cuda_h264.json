  "-preset", "p5",
  "-tune", "hq",
  "-gpu", "0",
  "-rc", "vbr",
  "-b:v", "6M",
  "-maxrate", "8M",
  "-bufsize", "12M",
  "-profile:v", "high",
  "-g", "50",
  "-bf", "2",
  "-map", "0:a?",
  "-c:a:0", "aac",
  "-b:a:0", "192k",
  "-ac:a:0", "2",
  "-ar:a:0", "48000",
  "-map_metadata", "0",
