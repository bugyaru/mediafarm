[
  "ffmpeg",
  "-hide_banner",
  "-loglevel", "level+info",
  "-progress", "pipe:1",
  "-nostats",
  "-y",
  "-nostdin",
  "-hwaccel", "cuda",
  "-hwaccel_output_format", "cuda",
  "-hwaccel_device", "0",
  "-i", "src.mp4",
  "-map", "0:v:0",
  "-vf", "scale_cuda=1920:1080:format=nv12",
